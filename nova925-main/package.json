{
  "name": "nova925-main",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sync-drive": "tsx sync-drive.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && node -e \"require('fs').copyFileSync('dist/client/index.html', 'dist/client/200.html')\" && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:cf": "vite build --outDir dist",
    "deploy:cf": "npm run build:cf && wrangler deploy",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^2.11.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/node": "^22.20.1",
    "argon2": "^0.44.0",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^3.114.17"
  }
}
